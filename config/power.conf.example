# power configuration file
# Place this file at ~/.config/power.conf

# Default command if none provided
# default = lock

# Customise locker priority order (comma-separated)
# locker_order = i3lock, gnome-screensaver-command -l, xlock, loginctl lock-session

# Customise logout priority order (comma-separated)
# logout_order = i3-msg exit, bspc quit, gnome-session-quit --logout --no-prompt

# Customise the `power menu` launcher priority order (comma-separated).
# Each entry is a full command; the menu options are piped to its stdin and
# the chosen one is read back from its stdout (the dmenu protocol). Point
# this at your own launcher once you build one, as long as it follows that
# same convention.
# menu_launcher_order = rofi -dmenu -p power, wofi --dmenu --prompt power, dmenu -p power

# Ask for confirmation before Poweroff, Reboot and Logout in `power menu`
# (default: true). Picking one reopens the menu with "Confirm <action>" and
# "Cancel"; Enter accepts. Lock, Suspend and Hibernate never ask, and direct
# commands such as `power poweroff` are unaffected.
# menu_confirm = true

# Lock the screen before suspending (default: true).
# If the lock fails, suspend is refused rather than leaving the session unlocked.
# lock_before_suspend = true

# Lock the screen before hibernating (default: true). Same behaviour as
# lock_before_suspend, applied to `power hibernate` / `power hb`.
# lock_before_hibernate = true
