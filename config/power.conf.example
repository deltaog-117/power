# power configuration file
# Place this file at ~/.config/power.conf

# Default command if none provided
# default = lock

# Customise locker priority order (comma-separated)
# locker_order = i3lock, gnome-screensaver-command -l, xlock, loginctl lock-session

# Customise logout priority order (comma-separated)
# logout_order = i3-msg exit, bspc quit, gnome-session-quit --logout --no-prompt

# Lock the screen before suspending (default: true).
# If the lock fails, suspend is refused rather than leaving the session unlocked.
# lock_before_suspend = true

# Lock the screen before hibernating (default: true). Same behaviour as
# lock_before_suspend, applied to `power hibernate` / `power hb`.
# lock_before_hibernate = true
